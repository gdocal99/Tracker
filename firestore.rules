rules_version = '2';

// Правила безопасности Cloud Firestore для трекера BLOCK 3.
// Каждый пользователь видит и правит ТОЛЬКО свой поддокумент users/{uid}/**.
// Незалогиненные — ничего. Чужие данные — недоступны.
//
// Как применить:
//   Firebase Console → Firestore Database → вкладка «Rules» → вставить это → Publish.
//   (или CLI: firebase deploy --only firestore:rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // Всё, что лежит под users/{uid}, доступно только владельцу этого uid.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Всё остальное — запрещено по умолчанию.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
